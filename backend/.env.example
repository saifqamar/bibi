# Copy to backend/.env for local development. Never commit real secrets.
BIBI_ENV=development
BIBI_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/bibi
BIBI_REDIS_URL=redis://localhost:6379
BIBI_QUEUE_BACKEND=arq
BIBI_SECRET_KEY=change-me-to-a-long-random-string
BIBI_PUBLIC_BASE_URL=http://localhost:8000
BIBI_STUDIO_URL=http://localhost:5173
BIBI_STORAGE_BACKEND=local
BIBI_STORAGE_DIR=var/storage
BIBI_EMAIL_BACKEND=console
