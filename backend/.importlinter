[importlinter]
root_package = app
include_external_packages = True

# Rule (spec 14): modules talk only through each other's public package (app.modules.<name>).
# Importing another module's submodules (models, repository, service, api, ...) is forbidden.

[importlinter:contract:boundary-identity]
name = Only the public package of 'identity' may be imported by other modules
type = forbidden
allow_indirect_imports = True
source_modules =
    app.modules.catalog
    app.modules.writing
    app.modules.ai
    app.modules.audio
    app.modules.listening
    app.modules.analytics
    app.modules.admin
    app.modules.billing
    app.modules.notifications
forbidden_modules =
    app.modules.identity.models
    app.modules.identity.repository
    app.modules.identity.service
    app.modules.identity.api
    app.modules.identity.schemas
    app.modules.identity.ports
    app.modules.identity.adapters
    app.modules.identity.graphs

