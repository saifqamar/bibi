[importlinter:contract:langgraph-only-in-ai]
name = LangGraph is only used inside the ai module
type = forbidden
source_modules =
    app.shared
    app.modules.identity
    app.modules.catalog
    app.modules.writing
    app.modules.audio
    app.modules.listening
    app.modules.analytics
    app.modules.admin
    app.modules.billing
    app.modules.notifications
forbidden_modules =
    langgraph
    langchain_core

[importlinter:contract:shared-is-base-layer]
name = Shared code never depends on feature modules
type = forbidden
source_modules =
    app.shared
forbidden_modules =
    app.modules

[importlinter:contract:vendor-sdks-only-in-adapters]
name = Vendor SDKs are imported only by their adapter
type = forbidden
source_modules =
    app
forbidden_modules =
    anthropic
    sentry_sdk
ignore_imports =
    app.modules.ai.adapters.anthropic_llm -> anthropic
    app.shared.monitoring -> sentry_sdk
