{
  "name": "bibi",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "api-client:generate": "pnpm --filter @bibi/api-client generate",
    "api-client:check": "pnpm --filter @bibi/api-client check",
    "studio:dev": "pnpm --filter @bibi/studio dev",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint"
  }
}
